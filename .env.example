# ═══════════════════════════════════════════════════════════
#  stock-multiagent 配置模板
# ═══════════════════════════════════════════════════════════
#
#  用法：
#      1) cp .env.example .env
#      2) 只需要改【下面第 1 行】—— 把 API Key 填进去
#      3) python3 graph.py
#
#  ⚠️ 真实密钥永不入库：.env 已被 .gitignore 排除，
#     本文件（.env.example）只放占位符，可以被提交。
#
#  ⚠️ 不要用 `cat .env` 打印内容 —— 会话记录明文落盘且撤不回。
#     要看键名用：sed -E 's/=.*/=<hidden>/' .env
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
#  ↓↓↓  唯一需要你填的地方：把下面这行等号右边换掉  ↓↓↓
# ───────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ───────────────────────────────────────────────────────────
#  以下都已填好或可选，一般不用动
# ───────────────────────────────────────────────────────────

# DeepSeek 的 OpenAI 兼容端点（公开地址，不是密钥）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：覆盖默认模型与温度（注释掉就用默认值）
# DEEPSEEK_MODEL=deepseek-chat
# ANALYST_TEMPERATURE=0.2

# 可选：想让它估算费用再填。单位 = 元 / 百万 token，
# 从官方定价页自己抄（本项目刻意不硬编码单价，避免过期）。
# 不填不会报错，只会打印「未配置单价」。
# DEEPSEEK_PRICE_IN_PER_M=
# DEEPSEEK_PRICE_OUT_PER_M=
